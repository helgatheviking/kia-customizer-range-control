{
	"name": "helgatheviking/kia-customizer-range-control",
	"type": "library",
	"license": "GPL-3.0-or-later",
	"description": "A Range Slider Control for the WordPress Customizer.",
	"homepage": "https://github.com/helgatheviking/kia-customizer-range-control",
	"authors": [
		{
			"name": "Kathy Darling",
			"homepage": "https://kathyisawesome.com"
		}
	],
	"keywords": [
		"wordpress",
		"wp",
		"customizer",
		"control"
	],
	"support": {
		"issues": "https://github.com/helgatheviking/kia-customizer-range-control/issues"
	},
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"classmap": [
			"class-kia-customizer-range-control.php"
		]
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.3",
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"wp-coding-standards/wpcs": "*",
		"woocommerce/woocommerce-sniffs": "^1.0.0"
	},
	"scripts": {
		"phpcs": [
			"phpcs . -s -p -n"
		],
		"phpcs-pre-commit": [
		  "phpcs . -s -p -n"
		],
		"phpcb": [
			"phpcbf ."
		]
	  },
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"extra": {
		"scripts-description": {
			"phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
			"phpcb": "Fix coding standards warnings/errors automatically with PHP Code Beautifier"
		}
	}
}